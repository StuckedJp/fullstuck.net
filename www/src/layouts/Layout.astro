---
const { frontmatter, url } = Astro.props;
---
<!doctype html>
<html lang="ja">
	<head>
		<title>{frontmatter.title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={new URL(url, Astro.site)} />
		<link rel="me" href="https://fedi.fullstuck.net/@su" />

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={frontmatter.description} />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={frontmatter.title} />
		<meta property="og:url" content={Astro.site} />
		<meta property="og:site_name" content="FullStuck.net" />
		<meta property="og:description" content={frontmatter.description} />
		<meta property="og:locale" content="ja_JP" />

		<meta property="article:author" content="FullStuck" />
		<meta property="article:tag" content="写真" />
		<meta property="article:tag" content="プログラミング" />
		<meta property="article:tag" content="撮り鉄" />
		<meta property="article:tag" content="旅行記" />
		<meta property="article:published_time" content={new Date(frontmatter.date).toISOString()}>
		<meta property="article:modified_time" content={new Date(frontmatter.lastModified).toISOString()}>
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content="@12648430" />
		<meta name="twitter:domain" content="fullstuck.net" />
		<meta name="twitter:title" content={frontmatter.title} />
		<meta name="twitter:description" content={frontmatter.description} />

		<meta name="fediverse:creator" content="@su@fedi.fullstuck.net" />
	</head>
	<body>
		<slot />
		<footer><p>Copyright 2026 FullStuck</p></footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 1rem;
	}
	footer {
		padding-top: 1rem;
		text-align: center;
		font-size: small;
	}
</style>
